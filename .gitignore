# ============================================================
# MaaAuto-Installer .gitignore
#
# 构建产物在 MaaAutoInstaller/_build（中间）与 dist（最终），两级都要忽略。
# ============================================================

# ---- 构建产物（build_release.py）----
MaaAutoInstaller/_build/
dist/
*.spec

# ---- 旧版本残留路径（兼容 2.x 脚本）----
build/
_embedded/
MaaAutoInstaller/tools/_out/
_work_*/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ---- 日志 / 临时文件 ----
*.log
*.bak
*.tmp

# ---- IDE / 操作系统 ----
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ---- 原有条目（保留，勿删）----
# Object file
*.o

# Ada Library Information
*.ali
